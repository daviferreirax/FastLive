# Caddy: HTTPS automático (Let's Encrypt) para o seu domínio.
{
	# O Caddy fica só na 443, então a porta 80 continua livre para outros sites.
	# O certificado é emitido pela própria 443 (desafio TLS-ALPN).
	# A porta HTTP interna (8780 por padrão) não precisa ser aberta no roteador.
	http_port {$CADDY_HTTP_PORT:8780}
	auto_https disable_redirects
}

{$DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip

	# Conexões do LiveKit (sinalização do vídeo)
	@livekit path /rtc /rtc/*
	reverse_proxy @livekit 127.0.0.1:7880

	# Site do PeekMe
	reverse_proxy 127.0.0.1:{$APP_PORT:3077}
}

# Ambiente de teste: mesmo Caddy e LiveKit, app separado na porta 3078.
teste.exemplo.duckdns.org {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip

	@livekit path /rtc /rtc/*
	reverse_proxy @livekit 127.0.0.1:7880

	reverse_proxy 127.0.0.1:3078
}
